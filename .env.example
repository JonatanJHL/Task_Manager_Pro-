# Copia este archivo como .env antes de correr docker compose up.
# setup.sh lo hace por ti y genera JWT_SECRET automáticamente.

# --- Base de datos (contenedor "db", nadie más la ve) ---
DB_NAME=taskmanager
DB_PASSWORD=cambia_este_password

# --- Autenticación ---
# Genera uno propio con: openssl rand -base64 32
JWT_SECRET=tu_clave_secreta_muy_larga

# --- Email (opcional) ---
# Si se deja vacío, los emails solo se imprimen en el log del contenedor "api".
RESEND_API_KEY=
FROM_EMAIL=Task Manager <onboarding@resend.dev>

# --- Red privada del equipo (VPN/oficina) ---
# Déjalo vacío mientras prueban. Cuando el equipo ya sepa la URL fija desde
# la que van a entrar (ej. http://taskmanager.oficina.local:8080), ponla aquí
# para que la API solo acepte pedidos de esa URL.
ALLOWED_ORIGIN=

# Copia este archivo como .env antes de correr docker compose up.
# setup.sh lo hace por ti y genera JWT_SECRET automáticamente.

# --- Base de datos (contenedor "db", nadie más la ve) ---
DB_NAME=taskmanager
DB_PASSWORD=cambia_este_password

# --- Autenticación ---
# Genera uno propio con: openssl rand -base64 32
JWT_SECRET=tu_clave_secreta_muy_larga

# --- Email (opcional) ---
# Si se deja vacío, los emails solo se imprimen en el log del contenedor "api".
RESEND_API_KEY=
FROM_EMAIL=Task Manager <onboarding@resend.dev>

# --- Acceso del equipo ---
# Si expones el proyecto solo en tu red local/VPN, pon aquí esa URL
# (ej. http://taskmanager.oficina.local:8080). Si lo expones a internet con
# Cloudflare Tunnel, usa la URL pública del frontend (ver FRONTEND_URL abajo).
# La API solo acepta pedidos que vengan de esta URL.
ALLOWED_ORIGIN=

# --- Exposición pública (Cloudflare Tunnel) ---
# URL pública del frontend (para armar los links de invitación por email).
FRONTEND_URL=https://app.tudominio.com
# URL pública de la API, con /api al final. Se "hornea" dentro del build del
# frontend (Vite la fija en tiempo de build, no se puede cambiar después sin
# reconstruir la imagen).
VITE_API_URL=https://api.tudominio.com/api
